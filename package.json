{
  "name": "root",
  "private": true,
  "homepage": "https://github.com/openscript/astro-i18n",
  "license": "MIT",
  "author": "Robin Bühler",
  "repository": "github:openscript/astro-i18n",
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm exec nx run-many --nx-bail --target=dev --parallel 10 --output-style stream",
    "build": "pnpm exec nx run-many --nx-bail --target=build --parallel 10 --output-style stream",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm exec nx run-many --nx-bail --target=test --parallel 10 --output-style=stream-without-prefixes",
    "type-check": "tsc --noEmit",
    "prepublish": "pnpm exec nx run-many --target=prepare --parallel",
    "version": "changeset version",
    "tag": "changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.2.1",
    "@nx/vite": "23.2.1",
    "@nx/vitest": "^23.2.1",
    "@nx/web": "23.2.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "jiti": "2.7.0",
    "nx": "23.2.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
