{
  "name": "astro-utils-i18n",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/astro-utils-i18n/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "vite build",
        "cwd": "{projectRoot}"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "cache": false,
      "options": {
        "command": "vite build --watch",
        "cwd": "{projectRoot}"
      }
    },
    "prepare": {
      "dependsOn": [
        "build"
      ],
      "command": "cp LICENSE libs/astro-utils-i18n"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
